{
  "version": 2,
  "installCommand": "npm install && cd client && npm install --include=dev",
  "buildCommand": "cd client && CI=false npm run build",
  "outputDirectory": "client/build",
  "build": {
    "env": {
      "NPM_CONFIG_PRODUCTION": "false",
      "CI": "false"
    }
  },
  "functions": {
    "api/server.js": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/server" }
  ]
}
