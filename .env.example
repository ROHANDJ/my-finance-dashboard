# Server Configuration
PORT=5000
NODE_ENV=development

# Database (Supabase)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT Secret (required in production — server refuses to sign/verify tokens without it)
JWT_SECRET=your_jwt_secret_key_here

# API Keys
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
FINNHUB_API_KEY=your_finnhub_key
YAHOO_FINANCE_API_KEY=your_yahoo_finance_key
OPENAI_API_KEY=your_openai_key

# Dhan broker integration (optional single-user/dev default; users can
# also connect their own token from the Portfolio page at runtime)
DHAN_ACCESS_TOKEN=your_dhan_access_token
DHAN_CLIENT_ID=your_dhan_client_id

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
# Optional sender shown in emails; defaults to "FinanceHub <EMAIL_USER>"
EMAIL_FROM=FinanceHub <your_email@gmail.com>

# Public URL of the app, used in password-reset email links
# (on Vercel defaults to the production domain; locally to http://localhost:3000)
APP_URL=https://my-finance-dashboard-ashen.vercel.app

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=your_twilio_number

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
